// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs" // 👈 Add this line!
}

datasource db {
  provider = "postgresql"
}

enum ROLE{
  user
  admin
}

model User {
  id  String @id @default(uuid())
  name String  
  email String @unique
  password String
  createdAt DateTime @default(now())   
  tokens Token[]
  folders Folder[] @relation("author")
  collaborator Collaborator[] @relation("collabs")
  isActive Boolean @default(true)
  role ROLE @default(user)
  @@map("users") // 👈Tells prismma call it User in vscode while users in pgadmin
}

model Token{
  id String @id @default(uuid())
  token String @unique
  expireAt DateTime 
  isVaild Boolean @default(true)
  userId String
  user User @relation(fields: [userId], references: [id])

  @@map("tokens")
}

enum AssetType{
  IMAGE
  VIDEO
}

model Asset{
  id String @id @default(uuid())
  assetName String 
  type AssetType 
  ownerId String
  description String
  coverImage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive Boolean @default(true)
  s3Key String
  fileSize Int
  mainFolder String?
  
  folder Folder? @relation("mainFolder", fields:[mainFolder], references:[id])
  assetFolder AssetFolder[] @relation("afJoin")

  assetTag AssetTag[] @relation("AssetTag")
  @@map("assets")

  //=> Add s3Key, coverImage
  //=> Remove isActive? Pintrest performs hard deletion
}

model Tag{
  id Int @id @default(autoincrement())
  name String @unique
  assetTag AssetTag[] @relation("AssetTag")

  @@map("tags")
}

model AssetTag{
  assetId String
  tagId Int
  asset Asset @relation("AssetTag", fields:[assetId],references:[id])
  tag Tag @relation("AssetTag",fields:[tagId],references:[id])

  @@id([assetId,tagId]) //Composite Key for both Ids  
  @@index([tagId])
  @@map("assettags")
}
 
model Folder{
  id String @id @default(uuid())
  folderName String
  parentId String?
  parentFolder Folder? @relation("FolderToFolder", fields:[parentId], references:[id])
  isPublic Boolean @default(true)
  userId String
  isActive Boolean @default(true)

  asset Asset[] @relation("mainFolder")
  children Folder[] @relation("FolderToFolder")
  user User @relation("author", fields:[userId],references:[id],onDelete:SetNull)

  assetFolder AssetFolder[] @relation("afJoin")
  collaborator Collaborator[] @relation("collabs")
  @@map("folders")
}

model AssetFolder{
  assetId String @default(uuid())
  folderId String @default(uuid())
  isOwner Boolean @default(false)
  createdAt DateTime @default(now())

  asset Asset @relation("afJoin",fields: [assetId], references:[id], onDelete: Cascade)
  folder Folder @relation("afJoin",fields: [folderId], references:[id], onDelete: Cascade)
  @@id([assetId,folderId])
  @@map("assetfolders")
}

model Collaborator{
  folderId String @default(uuid())
  userId String @default(uuid())
  createdAt DateTime @default(now())

  folder Folder @relation("collabs", fields:[folderId], references:[id], onDelete:Cascade)
  user User @relation("collabs", fields:[userId], references:[id], onDelete:Cascade)
  @@id([folderId,userId])
  @@map("collaborators")
}
