generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector(schema: "public")]
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  password     String
  createdAt    DateTime       @default(now())
  isActive     Boolean        @default(true)
  role         ROLE           @default(user)
  collaborator Collaborator[] @relation("collabs")
  folders      Folder[]       @relation("author")
  tokens       Token[]
  pphoto_key String @default("pphoto/generic_pphoto.png")
  @@map("users")
}

model Token {
  id       String   @id @default(uuid())
  token    String   @unique
  expireAt DateTime
  isVaild  Boolean  @default(true)
  userId   String
  user     User     @relation(fields: [userId], references: [id])

  @@map("tokens")
}

model Asset {
  id          String                 @id @default(uuid())
  assetName   String
  type        AssetType
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  description String
  isActive    Boolean                @default(true)
  fileSize    Int
  s3Key       String
  ownerId     String
  coverImage  String?
  mainFolder  String?
  width       Int
  height      Int
  embedding   Unsupported("vector(512)")?
  assetFolder AssetFolder[]          @relation("afJoin")
  folder      Folder?                @relation("mainFolder", fields: [mainFolder], references: [id])
  assetTag    AssetTag[]             @relation("AssetTag")

  @@map("assets")
}

model Tag {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  assetTag AssetTag[] @relation("AssetTag")

  @@map("tags")
}

model AssetTag {
  assetId String
  tagId   Int
  asset   Asset  @relation("AssetTag", fields: [assetId], references: [id], onDelete: Cascade)
  tag     Tag    @relation("AssetTag", fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId])
  @@map("assettags")
}

model Folder {
  id           String         @id @default(uuid())
  folderName   String
  parentId     String?
  isPublic     Boolean        @default(true)
  userId       String
  isActive     Boolean        @default(true)
  assetFolder  AssetFolder[]  @relation("afJoin")
  asset        Asset[]        @relation("mainFolder")
  collaborator Collaborator[] @relation("collabs")
  parentFolder Folder?        @relation("FolderToFolder", fields: [parentId], references: [id])
  children     Folder[]       @relation("FolderToFolder")
  user         User           @relation("author", fields: [userId], references: [id], onDelete: SetNull)

  @@map("folders")
}

model AssetFolder {
  assetId   String   @default(uuid())
  folderId  String   @default(uuid())
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  asset     Asset    @relation("afJoin", fields: [assetId], references: [id], onDelete: Cascade)
  folder    Folder   @relation("afJoin", fields: [folderId], references: [id], onDelete: Cascade)

  @@id([assetId, folderId])
  @@map("assetfolders")
}

model Collaborator {
  folderId  String   @default(uuid())
  userId    String   @default(uuid())
  createdAt DateTime @default(now())
  folder    Folder   @relation("collabs", fields: [folderId], references: [id], onDelete: Cascade)
  user      User     @relation("collabs", fields: [userId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
  @@map("collaborators")
}

enum ROLE {
  user
  admin
}

enum AssetType {
  IMAGE
  VIDEO
}
